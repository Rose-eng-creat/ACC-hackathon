{
  "manifest_version": 3,
  "name": "AI 学习伴侣",
  "version": "0.1.0",
  "description": "AI 学习伴侣：在 YouTube / B 站观看视频时提供知识点分析和问答辅助",

  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "https://api.openai-next.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "AI 学习伴侣"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
